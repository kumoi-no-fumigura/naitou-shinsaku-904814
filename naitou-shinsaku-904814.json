   ],
   "no": null,
   "maki": "下巻",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "卷下愁旅ロの御容態書をよみてかへりけりひそやかに人のうしろゆ、みちばた聖上、病重らせ給ふ*",
   "sachu": "",
   "poems": []
